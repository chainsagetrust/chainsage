{
  "name": "chainsage",
  "version": "0.1.0",
  "description": "Ask ChainSage for a verdict before your agent signs — ALLOW / REVIEW / DENY, grounded in live Base reads. Fails safe, never open.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["chainsage", "agent", "verdict", "base", "wallet-security", "x402", "mcp"],
  "license": "MIT",
  "peerDependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@chainsage/engine": "file:../engine",
    "@types/node": "^20.16.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "viem": "~2.21.0",
    "vitest": "^2.1.0"
  }
}
