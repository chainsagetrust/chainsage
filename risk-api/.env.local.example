# --- Base mainnet RPC (SERVER-SIDE ONLY — never NEXT_PUBLIC_) ---------------
# The Risk API reads live Base state through this endpoint. The key stays on the
# server and is never shipped to browsers. The public default works but
# rate-limits aggressively, which makes the ~30-day Approval log scan slow/flaky.
# A dedicated key (Alchemy / Infura / QuickNode) is STRONGLY recommended.
BASE_RPC_URL=https://mainnet.base.org

# --- API keys (comma-separated allowlist) -----------------------------------
# Callers must send a valid key as the `x-api-key` header (or `?key=`).
# The built-in public key `demo` is ALWAYS accepted (heavily rate-limited) so the
# developer console's "try it" works out of the box. Add your own keys here; in
# production, remove `demo` from acceptance by setting DISABLE_DEMO_KEY=1.
# NOTE: this is a STUB — see README "What's a stub". No billing, no persistence.
RISK_API_KEYS=

# Set to 1 to reject the public `demo` key (recommended for production).
DISABLE_DEMO_KEY=

# --- CORS --------------------------------------------------------------------
# Comma-separated allowed origins for browser callers. Default "*" (open).
RISK_API_CORS_ORIGINS=*

# --- Transaction-effect simulation (/guard, SERVER-SIDE ONLY) ---------------
# /guard simulates a proposed approve/transfer against LIVE Base state BEFORE
# signing (hidden-transfer / over-approval / intent-mismatch / revert) — but only
# when the request includes a `from` (owner) AND a provider below can run.
#
# Provider chain, tried in order (capability auto-detected):
#   1. Tenderly  — primary, most complete. THIRD-PARTY + PAID (https://tenderly.co):
#                  the tx is sent to Tenderly's servers and counts against your
#                  account quota. Keys are read server-side and NEVER shipped to the
#                  browser. Leave blank to skip Tenderly.
#   2. rpc-trace — debug_traceCall on BASE_RPC_URL, IF the node supports it
#                  (auto-detected; many public/QuickNode endpoints do not).
#   3. rpc-call  — degraded eth_call: detects revert only, no asset changes.
#   4. none      — nothing available → simulated:false (honest; never fabricated).
TENDERLY_ACCESS_KEY=
TENDERLY_ACCOUNT_SLUG=
TENDERLY_PROJECT_SLUG=

# Hard timeout (ms) for a single simulation — it is on the hot path before signing.
# A timeout is treated as "did not run" (simulated:false), never as a clean sim.
SIM_TIMEOUT_MS=4000
